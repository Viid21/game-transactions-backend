# Used by Docker Compose to create PostgreSQL. Change both values before a real deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=game_transactions

# Used when running the API directly on the host. Docker Compose replaces it with its internal URL.
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-password@localhost:5432/game_transactions
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3000

# Browser clients must be explicitly listed. Leave empty when only Unity calls the API.
CORS_ORIGINS=
# Set true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Use fake for local development. Set to steam only with real Steamworks credentials.
AUTH_PROVIDER=fake
PAYMENT_PROVIDER=fake

# Required when AUTH_PROVIDER=steam
STEAM_AUTH_KEY=
STEAM_AUTH_IDENTITY=

# Required when PAYMENT_PROVIDER=steam
STEAM_APP_ID=
STEAM_MICROTXN_KEY=
# Use the Steam sandbox unless explicitly deploying a production integration.
STEAM_MICROTXN_SANDBOX=true
STEAM_LANGUAGE=en
