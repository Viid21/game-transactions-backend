// use prisma-next

model Product {
  id           String @id @default(uuid())
  name         String
  description  String?
  type         String
  priceInCents Int
  currency     String

  orders       Order[]

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Player {
  id        String @id @default(uuid())
  username  String
  steamId   String? @unique

  orders   Order[]
  
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Order {
  id            String @id @default(uuid())
  providerOrderId String @unique
  playerId      String
  productId     String
  quantity      Int
  amountInCents Int
  currency      String
  status        String

  player        Player  @relation(fields: [playerId], references: [id])
  product       Product @relation(fields: [productId], references: [id])
  transactions  Transaction[]
  fulfillment   Fulfillment?

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Fulfillment {
  orderId String @id
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt TimestamptzString @default(now())
}

model Transaction {
  id                    String @id @default(uuid())
  orderId               String
  provider              String
  providerTransactionId String?
  status                String

  order Order @relation(fields: [orderId], references: [id])

  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()
}

model Inventory {
  playerId  String
  productId String
  quantity  Int

  player    Player  @relation(fields: [playerId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@id([playerId, productId])
}
